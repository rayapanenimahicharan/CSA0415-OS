#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat fileInfo;
    struct dirent *entry;
    DIR *dir;

    // Open a file
    fd = open("sample.txt", O_RDONLY);

    if (fd == -1)
    {
        perror("File opening failed");
        return 1;
    }

    printf("File opened successfully.\n");

    // fcntl system call
    int flags = fcntl(fd, F_GETFL);
    printf("File access mode: %d\n", flags & O_ACCMODE);

    // lseek system call
    off_t pos = lseek(fd, 0, SEEK_END);
    printf("File size using lseek: %ld bytes\n", (long)pos);

    // stat system call
    if (stat("sample.txt", &fileInfo) == 0)
    {
        printf("File size using stat: %ld bytes\n",
               (long)fileInfo.st_size);
        printf("File permissions: %o\n",
               fileInfo.st_mode & 0777);
    }

    close(fd);

    // opendir system call
    dir = opendir(".");

    if (dir == NULL)
    {
        perror("Directory opening failed");
        return 1;
    }

    printf("\nFiles in current directory:\n");

    // readdir system call
    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
