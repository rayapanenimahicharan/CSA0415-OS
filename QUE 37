#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i;
    int head, total = 0;
    int request[100];

    printf("Enter the number of disk requests: ");
    scanf("%d", &n);

    printf("Enter the disk request sequence: ");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &request[i]);
    }

    printf("Enter the initial head position: ");
    scanf("%d", &head);

    printf("\nDisk Head Movement:\n");
    printf("%d", head);

    for (i = 0; i < n; i++)
    {
        total += abs(head - request[i]);
        head = request[i];

        printf(" -> %d", head);
    }

    printf("\n\nTotal Head Movement = %d cylinders\n", total);

    return 0;
}
