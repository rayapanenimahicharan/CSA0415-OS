#include <stdio.h>

int main()
{
    int n, i, block, index[50];

    printf("Enter the number of blocks in the file: ");
    scanf("%d", &n);

    printf("Enter the block numbers:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &index[i]);
    }

    printf("\nIndex Block:\n");
    printf("Index\tBlock Number\n");

    for (i = 0; i < n; i++)
    {
        printf("%d\t%d\n", i, index[i]);
    }

    printf("\nEnter the block index to access: ");
    scanf("%d", &block);

    if (block >= 0 && block < n)
    {
        printf("The block number is: %d\n", index[block]);
    }
    else
    {
        printf("Invalid block index!\n");
    }

    return 0;
}
