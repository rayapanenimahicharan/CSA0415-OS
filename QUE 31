#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f, i, j, k;
    int pageFaults = 0, pageHits = 0;
    int pointer = 0, found;

    printf("Enter the number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string: ");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++)
        frames[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        // Check whether page is already present
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        if (found)
        {
            pageHits++;
            printf("%d\t", pages[i]);
        }
        else
        {
            frames[pointer] = pages[i];
            pointer = (pointer + 1) % f;
            pageFaults++;

            printf("%d\t", pages[i]);
        }

        for (k = 0; k < f; k++)
        {
            if (frames[k] == -1)
                printf("- ");
            else
                printf("%d ", frames[k]);
        }

        if (found)
            printf("\tPage Hit\n");
        else
            printf("\tPage Fault\n");
    }

    printf("\nTotal Page Faults = %d", pageFaults);
    printf("\nTotal Page Hits = %d\n", pageHits);

    return 0;
}
