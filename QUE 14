
#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][30], name[30];
    int n = 0, choice, i, found;

    while (1)
    {
        printf("\n1. Create File");
        printf("\n2. Delete File");
        printf("\n3. Search File");
        printf("\n4. Display Files");
        printf("\n5. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Enter file name: ");
                scanf("%29s", name);

                found = 0;
                for (i = 0; i < n; i++)
                    if (strcmp(files[i], name) == 0)
                        found = 1;

                if (found)
                    printf("File already exists");
                else if (n < 20)
                {
                    strcpy(files[n++], name);
                    printf("File created successfully");
                }
                else
                    printf("Directory is full");
                break;

            case 2:
                printf("Enter file name: ");
                scanf("%29s", name);

                for (i = 0; i < n; i++)
                    if (strcmp(files[i], name) == 0)
                        break;

                if (i == n)
                    printf("File not found");
                else
                {
                    for (; i < n - 1; i++)
                        strcpy(files[i], files[i + 1]);
                    n--;
                    printf("File deleted successfully");
                }
                break;

            case 3:
                printf("Enter file name: ");
                scanf("%29s", name);

                found = 0;
                for (i = 0; i < n; i++)
                    if (strcmp(files[i], name) == 0)
                        found = 1;

                if (found)
                    printf("File found");
                else
                    printf("File not found");
                break;

            case 4:
                printf("\nFiles in directory:\n");
                for (i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;

            case 5:
                return 0;

            default:
                printf("Invalid choice");
        }
    }
}
