
#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int source, destination;
    char buffer[1024];
    ssize_t n;

    source = open("source.txt", O_RDONLY);
    if (source < 0)
    {
        perror("Error opening source file");
        return 1;
    }

    destination = open("destination.txt",
                       O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (destination < 0)
    {
        perror("Error opening destination file");
        close(source);
        return 1;
    }

    while ((n = read(source, buffer, sizeof(buffer))) > 0)
    {
        ssize_t written = 0;

        while (written < n)
        {
            ssize_t w = write(destination, buffer + written,
                              n - written);

            if (w < 0)
            {
                perror("Error writing file");
                close(source);
                close(destination);
                return 1;
            }

            written += w;
        }
    }

    if (n < 0)
        perror("Error reading file");
    else
        printf("File copied successfully.\n");

    close(source);
    close(destination);

    return n < 0 ? 1 : 0;
}
